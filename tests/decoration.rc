# Minimal configuration used for manual/nested-X decoration checks.
mod_key : super
outer_gap : 8
inner_gap : 8
border_width : 2
animations : false
decorations_enabled : true
decoration_titlebar_height : 20
decoration_border_width : 1
decoration_resize_hit_width : 4
decoration_show_title : true
decoration_color_source : explicit
decoration_active_background : #313244
decoration_inactive_background : #1E1E2E
decoration_active_foreground : #FFFFFF
decoration_inactive_foreground : #A6ADC8
decoration_active_border : #89B4FA
decoration_inactive_border : #45475A

workspace_layout : 3 : dwindle

bind : mod + Return : "xterm"
call : mod + Shift + q : close
call : mod + grave : scratchpad_toggle 1
rule : class : NoDecoration : decorate false
