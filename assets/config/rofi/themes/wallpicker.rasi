* {
  bar-background: #121110;
  bar-foreground: #FCE8C3;
  tag-background: #917E6B;
  tag-foreground: #0E0D0C;
  block-background: #C5B088;
  block-foreground: #0E0D0C;
  highlight: underline bold #FCE8C3;
  margin: 0;
  padding: 0;
  spacing: 0;
  border: 0;
  background-color: transparent;
  text-color: @bar-foreground;
  font: "monospace bold 13";
}

window {
  width: 80%;
  location: center;
  anchor: center;
  border: 3px solid;
  border-color: @block-background;
  background-color: @bar-background;
}

mainbox {
  background-color: @bar-background;
  children: [inputbar, message, listview];
}

inputbar {
  margin: 6px;
  spacing: 6px;
  background-color: @bar-background;
  children: [prompt, entry];
}

prompt {
  expand: false;
  padding: 6px 10px;
  background-color: @tag-background;
  text-color: @tag-foreground;
}

entry {
  expand: true;
  padding: 6px 10px;
  border: 2px solid;
  border-color: @block-background;
  background-color: @bar-background;
  text-color: @bar-foreground;
  placeholder: "Filter wallpapers";
  placeholder-color: @bar-foreground;
}

listview {
  lines: 3;
  columns: 5;
  flow: horizontal;
  fixed-height: false;
  fixed-columns: false;
  scrollbar: false;
  cycle: true;
  spacing: 8px;
  margin: 0 6px 6px 6px;
  padding: 8px;
  border: 2px solid;
  border-color: @block-background;
  background-color: @bar-background;
}

element {
  orientation: vertical;
  padding: 5px;
  spacing: 5px;
  border: 2px solid;
  border-color: @bar-background;
  background-color: @bar-background;
  text-color: @bar-foreground;
  children: [element-icon, element-text];
}

element selected {
  border-color: @tag-background;
  background-color: @bar-background;
  text-color: @tag-foreground;
}

element-icon {
  size: 10em;
  background-color: @bar-background;
  horizontal-align: 0.5;
  vertical-align: 0.5;
}

element-text {
  expand: true;
  padding: 6px;
  background-color: @block-background;
  text-color: @block-foreground;
  horizontal-align: 0.5;
  vertical-align: 0.5;
}

element-text selected {
  background-color: @tag-background;
  text-color: @tag-foreground;
}

message {
  margin: 0 6px 6px 6px;
  background-color: @bar-background;
}

textbox {
  padding: 6px 9px;
  border: 2px solid;
  border-color: @tag-background;
  background-color: @bar-background;
  text-color: @bar-foreground;
}

error-message {
  padding: 10px;
  background-color: @bar-background;
  text-color: @bar-foreground;
}
