# skarwm configuration example.
# Install as ~/.config/skarwm/skarwm.rc or /etc/skarwm/skarwm.rc.
# Override with SKARWM_CONFIG or `skarwm -c FILE`; reload with Mod+Shift+r.
# Lines beginning with # are comments.

# Settings: appearance and window behavior.
mod_key : super
outer_gap : 8
inner_gap : 8
border_width : 2
corner_radius : 0
norm_outer_border : #504D47
sel_outer_border  : #FCE8C3
decorations_enabled : false
decoration_titlebar_height : 20
decoration_border_width : 1
decoration_resize_hit_width : 4
decoration_show_title : true
decoration_color_source : active-border
# decoration_accent : #89B4FA
# decoration_active_background : #313244
# decoration_inactive_background : #1E1E2E
# decoration_active_foreground : #FFFFFF
# decoration_inactive_foreground : #A6ADC8
# decoration_active_border : #89B4FA
# decoration_inactive_border : #45475A
focus_follows_mouse : true
preview_hover_delay_ms : 250

# Animations: layout transition timing.
animations : true
animation_duration_ms : 180
animation_fps : 60
animation_easing : ease_out_cubic

# Bar: appearance and ordered blocks.
bar_enabled : true
bar_position : top
bar_height : 26
bar_font : "JetBrainsMono Nerd Font"
bar_font_size : 12
bar_font_weight : normal
bar_foreground : #FCE8C3
bar_background : #121110
bar_tag_count : 12
bar_tag_foreground : #0E0D0C
bar_tag_background : #917E6B
bar_block_foreground : #0E0D0C
bar_block_background : #C5B088
bar_block : workspaces : left
bar_block : layout : left
bar_block : title : center
bar_block : script : center : 󰃭 : 1 : 1 : "date '+%a, %b %d - %H:%M:%S'"
bar_block : script : right : 󰍛 : 2 : 1 : "free -b | awk '/Mem:/ {print int($3/107374182.4)/10 "/" int($2/107374182.4)/10 "GB"}'"
bar_block : script : right :  : 2 : 3 : "grep 'cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5)} END {print int(usage+0.5) "%"}'"
bar_block : script : right : 󰋊 : 30 : 1 : "df -P / | awk 'NR==2 {print $5}'"
bar_block : bluetooth : right : 󰂯
bar_block : network : right : 󰤨 : _ : _
bar_block : audio : right : 󰕾 : "pavucontrol"
bar_block : script : right : 󰁹 : 10 : 1 : "cat /sys/class/power_supply/BAT0/capacity; printf '%%'"
bar_block : systray : right
# bar_block : button : left : 󰀻 : "rofi -show drun"

# Virtual screen: output : split : left percent : pixel offset.
# virtual_screen : DP-1 : split : 75 : -30

# Workspaces: assign a layout, icon, and name.
# workspace number : workspace layout : workspace icon : workspace name
# workspace-1 : scrolling-tile : 󰈹 : Web
# workspace-3 : dwindle : 󰆍 : Code
# workspace-5 : monocle : 󰍹 : Focus

# Launching: bind runs commands; autostart runs once.
bind : mod + Return : "st"
# bind : mod + Return : "kitty"
autostart : "xsetroot -solid '#202020'"
# autostart : "picom --config ~/.config/picom/picom.conf -b"
# autostart : "dunst -config ~/.config/dunst/dunstrc"

# Window actions.
call : mod + h : focusleft
call : mod + j : focusdown
call : mod + k : focusup
call : mod + l : focusright
call : mod + Control + h : resizeleft
call : mod + Control + j : resizedown
call : mod + Control + k : resizeup
call : mod + Control + l : resizeright
call : mod + Shift + h : moveleft
call : mod + Shift + j : movedown
call : mod + Shift + k : moveup
call : mod + Shift + l : moveright
call : mod + space : togglefloating
call : mod + Shift + space : togglealwaysontop
call : mod + f : togglefullscreen
call : mod + t : toggle_tabbed
call : mod + g : layout_next
call : mod + Control + Alt + h : show_bindings
call : mod + Control + Alt + t : show_datetime
call : mod + Control + Alt + b : show_battery
call : mod + Control + r : reminder_new
call : mod + Control + Alt + r : reminder_show_all
call : mod + Control + Shift + r : reminder_clear_all
call : mod + Shift + q : close_window
call : mod + Shift + r : reload_config

# Optional lock, brightness, and audio commands.
# bind : mod + Shift + x : "betterlockscreen -l"
# bind : XF86MonBrightnessUp : "brightnessctl set +5%"
# bind : XF86MonBrightnessDown : "brightnessctl set 5%-"
# bind : XF86AudioRaiseVolume : "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"
# bind : XF86AudioLowerVolume : "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
# bind : XF86AudioMute : "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"

# Scratchpads and workspace navigation.
call : mod + grave : scratchpad_toggle 1
call : mod + Shift + grave : scratchpad_toggle_float 2
call : mod + Control + grave : scratchpad_remove 1
call : mod + n : ws_next
call : mod + p : ws_prev
call : mod + Control + n : tag_next
call : mod + Control + p : tag_prev

# Multiple-monitor navigation.
call : mod + comma : focus_output_prev
call : mod + period : focus_output_next
call : mod + Shift + comma : move_to_output_prev
call : mod + Shift + period : move_to_output_next

# Focus matching windows; criteria may be combined.
# call : mod + a : focus class URxvt title VIM
# call : mod + m : focus title "Music Player"

# Virtual-screen controls.
call : mod + F5 : screen_split_shrink 15
call : mod + F6 : screen_split_disable
call : mod + F7 : screen_split_enable 75
call : mod + F8 : screen_split_grow 15

# Dynamic workspaces: view switches; tag moves the focused window.
workspace : mod + 1 : view 1
workspace : mod + 2 : view 2
workspace : mod + 3 : view 3
workspace : mod + 4 : view 4
workspace : mod + Shift + 1 : tag 1
workspace : mod + Shift + 2 : tag 2
workspace : mod + Shift + 3 : tag 3
workspace : mod + Shift + 4 : tag 4

# Rules: field : substring : effects.
rule : class : XTerm : floating
rule : title : Network : floating
rule : instance : firefox : workspace 3
rule : title : "Mozilla Firefox" : floating

# import : config.d/keybindings.rc