#!/bin/sh

# Display-manager entry point. Prefer packaged extras when present, while
# allowing every path to be overridden from ~/.profile or the display manager.
if [ -z "${SKARWM_EXTRA_DIR:-}" ]; then
    if [ -d /usr/share/skarwm/extra ]; then
        SKARWM_EXTRA_DIR=/usr/share/skarwm/extra
    else
        SKARWM_EXTRA_DIR="$HOME/.config/skarwm"
    fi
fi
export SKARWM_EXTRA_DIR

if [ -z "${SKARWM_CONFIG:-}" ] && [ -f "$SKARWM_EXTRA_DIR/config.rc" ]; then
    SKARWM_CONFIG="$SKARWM_EXTRA_DIR/config.rc"
    export SKARWM_CONFIG
fi

if [ -z "${SKARWM_STATE_DIR:-}" ]; then
    case "$SKARWM_EXTRA_DIR" in
        /usr/share/*) SKARWM_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/skarwm" ;;
        *)            SKARWM_STATE_DIR="$SKARWM_EXTRA_DIR" ;;
    esac
fi
export SKARWM_STATE_DIR
mkdir -p "$SKARWM_STATE_DIR"

export KITTY_CONFIG_DIRECTORY="$SKARWM_EXTRA_DIR/kitty"
exec skarwm "$@"
