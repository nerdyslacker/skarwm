#!/usr/bin/env python3

"""Print renCal/Caldir events as JSON for the Quickshell calendar."""

from __future__ import annotations

import json
import os
import re
from datetime import datetime, time, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError


def config_value(path: Path, key: str) -> str | None:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return None
    match = re.search(rf'^\s*{re.escape(key)}\s*=\s*["\']([^"\']+)["\']', text, re.MULTILINE)
    return match.group(1) if match else None


def calendar_root() -> Path:
    configured = os.environ.get("CALDIR_DIR")
    if not configured:
        config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
        configured = config_value(config_home / "caldir" / "config.toml", "calendar_dir")
    return Path(configured or "~/caldir").expanduser()


def unfold(text: str) -> list[str]:
    lines: list[str] = []
    for line in text.replace("\r\n", "\n").split("\n"):
        if line.startswith((" ", "\t")) and lines:
            lines[-1] += line[1:]
        else:
            lines.append(line)
    return lines


def unescape(value: str) -> str:
    return (value.replace("\\n", " ").replace("\\N", " ")
            .replace("\\,", ",").replace("\\;", ";").replace("\\\\", "\\"))


def parse_time(name: str, value: str) -> tuple[datetime, bool] | None:
    params = name.split(";")[1:]
    is_date = "VALUE=DATE" in params or re.fullmatch(r"\d{8}", value) is not None
    try:
        if is_date:
            parsed_date = datetime.strptime(value[:8], "%Y%m%d").date()
            return datetime.combine(parsed_date, time.min).astimezone(), True

        utc = value.endswith("Z")
        raw = value[:-1] if utc else value
        fmt = "%Y%m%dT%H%M%S" if len(raw) >= 15 else "%Y%m%dT%H%M"
        parsed = datetime.strptime(raw, fmt)
        if utc:
            parsed = parsed.replace(tzinfo=timezone.utc).astimezone()
        else:
            tzid = next((p[5:] for p in params if p.startswith("TZID=")), "")
            if tzid:
                try:
                    parsed = parsed.replace(tzinfo=ZoneInfo(tzid)).astimezone()
                except ZoneInfoNotFoundError:
                    parsed = parsed.astimezone()
            else:
                parsed = parsed.astimezone()
        return parsed, False
    except (ValueError, OverflowError):
        return None


def calendar_name(directory: Path) -> str:
    return config_value(directory / ".caldir" / "config.toml", "name") or directory.name


def event_dates(start: datetime, end: datetime, all_day: bool) -> list[str]:
    last = end.date() - timedelta(days=1) if all_day else end.date()
    if last < start.date():
        last = start.date()
    result = []
    current = start.date()
    while current <= last and len(result) < 367:
        result.append(current.isoformat())
        current += timedelta(days=1)
    return result


def read_events(path: Path, name: str) -> list[dict[str, object]]:
    try:
        lines = unfold(path.read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return []

    events: list[dict[str, object]] = []
    fields: dict[str, tuple[str, str]] | None = None
    for line in lines:
        if line == "BEGIN:VEVENT":
            fields = {}
            continue
        if line == "END:VEVENT" and fields is not None:
            start_field = fields.get("DTSTART")
            if start_field and fields.get("STATUS", ("", ""))[1].upper() != "CANCELLED":
                start_value = parse_time(*start_field)
                end_field = fields.get("DTEND")
                end_value = parse_time(*end_field) if end_field else None
                if start_value:
                    start, all_day = start_value
                    end = end_value[0] if end_value else start + (
                        timedelta(days=1) if all_day else timedelta(0))
                    events.append({
                        "title": unescape(fields.get("SUMMARY", ("", "Untitled event"))[1]),
                        "uid": fields.get("UID", ("", ""))[1],
                        "recurrenceId": fields.get("RECURRENCE-ID", ("", ""))[1],
                        "start": start.isoformat(),
                        "end": end.isoformat(),
                        "allDay": all_day,
                        "calendar": name,
                        "dates": event_dates(start, end, all_day),
                    })
            fields = None
            continue
        if fields is None or ":" not in line:
            continue
        field, value = line.split(":", 1)
        base = field.split(";", 1)[0].upper()
        if base in {"DTSTART", "DTEND", "SUMMARY", "STATUS", "UID", "RECURRENCE-ID"}:
            fields[base] = (field, value)
    return events


def main() -> None:
    root = calendar_root()
    now = datetime.now().astimezone()
    lower = now - timedelta(days=40)
    upper = now + timedelta(days=400)
    events: list[dict[str, object]] = []
    if root.is_dir():
        for directory in root.iterdir():
            if not directory.is_dir():
                continue
            name = calendar_name(directory)
            for path in directory.glob("*.ics"):
                for event in read_events(path, name):
                    start = datetime.fromisoformat(str(event["start"]))
                    end = datetime.fromisoformat(str(event["end"]))
                    if end >= lower and start <= upper:
                        events.append(event)
    events.sort(key=lambda event: str(event["start"]))
    print(json.dumps(events, ensure_ascii=False, separators=(",", ":")))


if __name__ == "__main__":
    main()
