#!/bin/sh

# Rofi power menu for an elogind/runit skarwm session.
set -eu

config_root=$(dirname "$(dirname "$(readlink -f "$0")")")
theme="$config_root/rofi/power.rasi"

chosen=$(printf '%s\n' '[Cancel]' 'Lock' 'Logout' 'Shutdown' 'Reboot' |
    rofi -dmenu -i -p 'Power Menu' -theme "$theme") || exit 0

case "$chosen" in
    Lock) betterlockscreen -l ;;
    Logout) skarwm-msg quit ;;
    Shutdown) loginctl poweroff ;;
    Reboot) loginctl reboot ;;
    *) exit 0 ;;
esac
