#!/bin/sh

# Change the default sink volume and show a Dunst progress notification.
set -eu

step=2

get_volume() {
    pactl get-sink-volume @DEFAULT_SINK@ |
        sed -n 's/.* \([0-9][0-9]*\)%.*/\1/p' | head -n 1
}

is_muted() {
    pactl get-sink-mute @DEFAULT_SINK@ | grep -q 'yes$'
}

notify_volume() {
    volume=$(get_volume)
    if is_muted; then
        icon=audio-volume-muted
        value=0
        label="Volume muted"
    else
        value=$volume
        label="Volume ${volume}%"
        if [ "$volume" -le 30 ]; then icon=audio-volume-low
        elif [ "$volume" -le 70 ]; then icon=audio-volume-medium
        else icon=audio-volume-high
        fi
    fi
    notify-send -a changevolume -u low \
        -h string:x-canonical-private-synchronous:volume \
        -h "int:value:$value" -i "$icon" -t 2000 "$label"
}

case "${1:-}" in
    up)
        pactl set-sink-mute @DEFAULT_SINK@ 0
        pactl set-sink-volume @DEFAULT_SINK@ "+${step}%"
        ;;
    down)
        pactl set-sink-mute @DEFAULT_SINK@ 0
        pactl set-sink-volume @DEFAULT_SINK@ "-${step}%"
        ;;
    mute)
        pactl set-sink-mute @DEFAULT_SINK@ toggle
        ;;
    *)
        printf 'usage: %s {up|down|mute}\n' "$0" >&2
        exit 2
        ;;
esac

notify_volume
