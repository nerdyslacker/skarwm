#!/bin/sh

# Keep external application highlights in sync with Quickshell's selected
# Srcery accent. Configurations installed under SKARWM_EXTRA_DIR are normally
# user-owned; packaged, read-only configurations are left untouched.
set -u

accent=${1:-}
case $accent in
    \#*) ;;
    *) exit 2 ;;
esac
case ${accent#\#} in
    *[!0-9A-Fa-f]*|'') exit 2 ;;
esac
[ "${#accent}" -eq 7 ] || exit 2

extra_dir=${SKARWM_EXTRA_DIR:-"$HOME/.config/skarwm"}

rewrite() {
    file=$1
    expression=$2
    [ -f "$file" ] && [ -w "$file" ] || return 0

    temporary=$(mktemp "${file}.accent.XXXXXX") || return 1
    if sed -E "$expression" "$file" > "$temporary"; then
        chmod 644 "$temporary"
        mv "$temporary" "$file"
    else
        rm -f "$temporary"
        return 1
    fi
}

rewrite "$extra_dir/rofi/colors.rasi" \
    "/^[[:space:]]*(accent|border|prompt-fg):/ s/#[0-9A-Fa-f]{6}/$accent/"

rewrite "$extra_dir/kitty/current-theme.conf" \
    "/^[[:space:]]*(active_border_color|active_tab_background|mark1_background)[[:space:]]+/ s/#[0-9A-Fa-f]{6}/$accent/"

rewrite "$extra_dir/dunst/dunstrc" \
    "/THEME: dunst_(frame_(global|low|normal)|highlight_normal)/ s/#[0-9A-Fa-f]{6}/$accent/"

rewrite "$extra_dir/polybar/colors.ini" \
    "/^[[:space:]]*(primary|border)[[:space:]]*=/ s/#[0-9A-Fa-f]{6}/$accent/"

rewrite "$extra_dir/config.rc" \
    "/^[[:space:]]*sel_outer_border[[:space:]]*:/ s/#[0-9A-Fa-f]{6}/$accent/"

# Rofi reads its theme for every invocation. Reload existing Kitty and Dunst
# processes when their control mechanisms are available.
if [ "${SKARWM_ACCENT_NO_RELOAD:-0}" != 1 ]; then
    if command -v pkill >/dev/null 2>&1; then
        pkill -USR1 -x kitty 2>/dev/null || true
    fi
    if command -v dunstctl >/dev/null 2>&1; then
        dunstctl reload >/dev/null 2>&1 || true
    elif command -v pkill >/dev/null 2>&1; then
        pkill -HUP -x dunst 2>/dev/null || true
    fi
    message=$(command -v skarwm-msg 2>/dev/null || true)
    if [ -z "$message" ] && [ -x "$extra_dir/../build/skarwm-msg" ]; then
        message=$extra_dir/../build/skarwm-msg
    fi
    [ -z "$message" ] || "$message" reload >/dev/null 2>&1 || true
fi
