#!/bin/sh

# network — toggle the network manager window (its own quickshell instance,
# separate from the bar).


config_root=${SKARWM_EXTRA_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}
P="$config_root/quickshell-network"

if pgrep -f "qs -p $P" >/dev/null 2>&1; then
    qs -p "$P" kill
else
    exec qs -p "$P" -d -n
fi
